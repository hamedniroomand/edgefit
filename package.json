{
  "name": "edgefit",
  "version": "0.8.0",
  "description": "Check whether a project and its dependencies will run on edge and alternative JS runtimes",
  "keywords": [
    "bun",
    "cloudflare-workers",
    "compatibility",
    "deno",
    "edge",
    "workerd"
  ],
  "homepage": "https://edgefit.kitdev.space/",
  "bugs": "https://github.com/hamedniroomand/edgefit/issues",
  "license": "MIT",
  "author": "Hamed Niroomand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedniroomand/edgefit.git"
  },
  "bin": {
    "edgefit": "./dist/cli/main.mjs"
  },
  "files": [
    "dist",
    "data",
    "docs/public/schema/report-v2.json"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./schema/report-v2.json": "./docs/public/schema/report-v2.json"
  },
  "scripts": {
    "build": "vp pack",
    "changeset": "changeset",
    "changeset:version": "changeset version && vp fmt",
    "dev": "vp run edgefit-docs#dev",
    "docs:build": "vp run edgefit-docs#build",
    "docs:dev": "vp run edgefit-docs#dev",
    "docs:preview": "vp run edgefit-docs#preview",
    "docs:results": "git fetch --depth 1 origin package-results && mkdir -p docs/public/packages && git archive FETCH_HEAD | tar -x -C docs/public/packages",
    "format": "vp fmt",
    "lint": "vp lint",
    "prepare": "vp config",
    "ready": "vp check && vp run -r test && vp run -r build",
    "test": "vp test"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "oxc-parser": "^0.152.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "ajv": "^8.20.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.8.1"
}
